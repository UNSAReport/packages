#let font-family = ("Calibri", "Carlito")
#let font-size = 12pt
#let font-lang = "es"
#let font-hyphenate = false

#let page-paper = "a4"
#let cover-margin = (x: 2cm, y: 2.2cm)
#let body-margin = (top: 2.2cm, bottom: 2.2cm, left: 1.5cm, right: 2cm)
#let page-numbering = "1"
#let page-number-align = center

#let par-justify = true
#let par-first-line-indent = 0pt
#let par-spacing = 0.75em
#let par-leading = 0.6em
#let cover-par-leading = 1.2em

#let heading-font-size = 12pt
#let heading-weight = "bold"
#let heading-space-above = 1.15em
#let heading-space-below = 0.75em
#let title-text-size = 14pt
#let title-weight = "bold"
#let title-space-below = 1.2em

#let indent-width = 12pt
#let num-gutter = 0.6em

#let table-header-fill = rgb("e5e7eb")
#let table-cell-stroke = 0.5pt + luma(180)
#let table-text-size = 8.5pt
#let table-header-weight = "bold"

#let cover-logo-width = 5cm
#let faculty = "FACULTAD DE INGENIERÍA DE PRODUCCIÓN Y SERVICIOS"
#let school = "ESCUELA PROFESIONAL DE INGENIERÍA DE SISTEMAS"
